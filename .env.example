NODE_ENV=development
PORT=4000

# Database Configuration
MONGO_URI=mongodb://localhost:27017/store_management_db

# Auth Secrets
ADMIN_JWT_SECRET=your_admin_jwt_secret
ADMIN_JWT_EXPIRES_IN=7d

STORE_EMPLOYEE_JWT_SECRET=your_store_employee_jwt_secret
STORE_EMPLOYEE_JWT_EXPIRES_IN=7d

# Security / Crypto Key (64 hex characters)
CRYPTO_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend URL
FRONTEND_URL=http://localhost:5173

# AWS / S3 Storage Configuration
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_PUBLIC_URL=

# MSG91 Mailer Configuration
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_DOMAIN=your_msg91_domain
MSG91_SENDER_NAME=Store Management
MSG91_FROM_EMAIL=no-reply@yourdomain.com
