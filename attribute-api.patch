+++ b/controllers/attributeController.js
@@ -0,0 +1,328 @@
+import Attribute from "../models/AttributeSchema.js";
+
+const normalizeArray = (value) => {
+  if (value === undefined || value === null || value === "") return [];
+
+  if (Array.isArray(value)) {
+    return value.map((item) => String(item).trim()).filter(Boolean);
+  }
+
+  return String(value)
+    .split(",")
+    .map((item) => item.trim())
+    .filter(Boolean);
+};
+
+// Create Attribute
+export const createAttribute = async (req, res) => {
+  try {
+    const { attribute, key, fieldType, appliesTo, options } = req.body;
+
+    if (!attribute || !key || !fieldType) {
+      return res.status(400).json({
+        success: false,
+        error: "attribute, key and fieldType are required",
+      });
+    }
+
+    const normalizedKey = String(key).trim().toLowerCase();
+
+    const existingAttribute = await Attribute.findOne({
+      key: normalizedKey,
+      isDeleted: false,
+    });
+
+    if (existingAttribute) {
+      return res.status(400).json({
+        success: false,
+        error: "Attribute with the same key already exists",
+      });
+    }
+
+    const newAttribute = new Attribute({
+      attribute: String(attribute).trim(),
+      key: normalizedKey,
+      fieldType,
+      appliesTo: normalizeArray(appliesTo),
+      options: normalizeArray(options),
+      createdBy: req.user.id,
+      creatorModel: req.user.creatorModel,
+    });
+
+    await newAttribute.save();
+
+    return res.status(201).json({
+      success: true,
+      message: "Attribute created successfully",
+      attribute: newAttribute,
+    });
+  } catch (error) {
+    console.error("Error creating attribute:", error);
+
+    if (error.name === "ValidationError") {
+      return res.status(400).json({
+        success: false,
+        error: error.message,
+      });
+    }
+
+    return res.status(500).json({
+      success: false,
+      error: "Internal server error",
+    });
+  }
+};
+
+// Get All Attributes
+// Search + Status Filter + Pagination
+export const getAllAttributes = async (req, res) => {
+  try {
+    const { search, status } = req.query;
+
+    const filter = {
+      isDeleted: false,
+    };
+
+    // Status filter
+    if (status !== undefined) {
+      if (status === "true" || status === "false") {
+        filter.status = status === "true";
+      } else if (status === "active") {
+        filter.status = true;
+      } else if (status === "inactive") {
+        filter.status = false;
+      }
+    }
+
+    // Search
+    if (search) {
+      filter.$or = [
+        { attribute: { $regex: search, $options: "i" } },
+        { key: { $regex: search, $options: "i" } },
+        { fieldType: { $regex: search, $options: "i" } },
+        { appliesTo: { $regex: search, $options: "i" } },
+      ];
+    }
+
+    // Pagination
+    const page = Math.max(parseInt(req.query.page) || 1, 1);
+    const limit = Math.min(
+      Math.max(parseInt(req.query.limit) || 10, 1),
+      100
+    );
+
+    const skip = (page - 1) * limit;
+
+    const totalDocuments = await Attribute.countDocuments(filter);
+
+    const attributes = await Attribute.find(filter)
+      .sort({ createdAt: -1 })
+      .skip(skip)
+      .limit(limit)
+      .populate("createdBy", "fullname role");
+
+    return res.status(200).json({
+      success: true,
+      currentPage: page,
+      totalPages: Math.ceil(totalDocuments / limit),
+      totalDocuments,
+      attributes,
+    });
+  } catch (error) {
+    console.error("Error fetching attributes:", error);
+
+    return res.status(500).json({
+      success: false,
+      error: "Internal server error",
+    });
+  }
+};
+
+// Get Attribute By ID
+export const getAttributeById = async (req, res) => {
+  try {
+    const { id } = req.params;
+
+    const attribute = await Attribute.findOne({
+      _id: id,
+      isDeleted: false,
+    }).populate("createdBy", "fullname role");
+
+    if (!attribute) {
+      return res.status(404).json({
+        success: false,
+        error: "Attribute not found",
+      });
+    }
+
+    return res.status(200).json({
+      success: true,
+      attribute,
+    });
+  } catch (error) {
+    console.error("Error fetching attribute:", error);
+
+    return res.status(500).json({
+      success: false,
+      error: "Internal server error",
+    });
+  }
+};
+
+// Update Attribute
+export const updateAttribute = async (req, res) => {
+  try {
+    const { id } = req.params;
+    const { attribute, key, fieldType, appliesTo, options } = req.body;
+
+    if (!attribute || !key || !fieldType) {
+      return res.status(400).json({
+        success: false,
+        error: "attribute, key and fieldType are required",
+      });
+    }
+
+    const normalizedKey = String(key).trim().toLowerCase();
+
+    const duplicate = await Attribute.findOne({
+      key: normalizedKey,
+      _id: { $ne: id },
+      isDeleted: false,
+    });
+
+    if (duplicate) {
+      return res.status(400).json({
+        success: false,
+        error: "Another attribute with the same key already exists",
+      });
+    }
+
+    const updatedAttribute = await Attribute.findOneAndUpdate(
+      {
+        _id: id,
+        isDeleted: false,
+      },
+      {
+        attribute: String(attribute).trim(),
+        key: normalizedKey,
+        fieldType,
+        appliesTo: normalizeArray(appliesTo),
+        options: normalizeArray(options),
+      },
+      {
+        new: true,
+        runValidators: true,
+      }
+    );
+
+    if (!updatedAttribute) {
+      return res.status(404).json({
+        success: false,
+        error: "Attribute not found or deleted",
+      });
+    }
+
+    return res.status(200).json({
+      success: true,
+      message: "Attribute updated successfully",
+      attribute: updatedAttribute,
+    });
+  } catch (error) {
+    console.error("Error updating attribute:", error);
+
+    return res.status(500).json({
+      success: false,
+      error: "Internal server error",
+    });
+  }
+};
+
+// Delete Attribute
+export const deleteAttribute = async (req, res) => {
+  try {
+    const { id } = req.params;
+
+    const attribute = await Attribute.findOneAndUpdate(
+      {
+        _id: id,
+        isDeleted: false,
+      },
+      {
+        isDeleted: true,
+      },
+      {
+        new: true,
+      }
+    );
+
+    if (!attribute) {
+      return res.status(404).json({
+        success: false,
+        error: "Attribute not found or already deleted",
+      });
+    }
+
+    return res.status(200).json({
+      success: true,
+      message: "Attribute deleted successfully",
+    });
+  } catch (error) {
+    console.error("Error deleting attribute:", error);
+
+    return res.status(500).json({
+      success: false,
+      error: "Internal server error",
+    });
+  }
+};
+
+// Active / Inactive Toggle
+export const updateAttributeStatus = async (req, res) => {
+  try {
+    const { id } = req.params;
+    const { status } = req.body;
+
+    if (typeof status !== "boolean") {
+      return res.status(400).json({
+        success: false,
+        error: "status must be a boolean",
+      });
+    }
+
+    const attribute = await Attribute.findOneAndUpdate(
+      {
+        _id: id,
+        isDeleted: false,
+      },
+      {
+        status,
+      },
+      {
+        new: true,
+        runValidators: true,
+      }
+    );
+
+    if (!attribute) {
+      return res.status(404).json({
+        success: false,
+        error: "Attribute not found or deleted",
+      });
+    }
+
+    return res.status(200).json({
+      success: true,
+      message: `Attribute ${
+        status ? "activated" : "deactivated"
+      } successfully`,
+      attribute,
+    });
+  } catch (error) {
+    console.error("Error updating attribute status:", error);
+
+    return res.status(500).json({
+      success: false,
+      error: "Internal server error",
+    });
+  }
+};
